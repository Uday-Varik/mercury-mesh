# --- telephony ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+1...

# --- AI services (voice pipeline) ---
DEEPGRAM_API_KEY=
OPENAI_API_KEY=
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=

# --- public URLs (Twilio must reach these; use ngrok/cloudflared in dev) ---
PUBLIC_HTTP_URL=https://YOUR_HOST
PUBLIC_WS_URL=wss://YOUR_HOST

# --- sourcing (optional, for real provider integrations) ---
APOLLO_API_KEY=
SERPAPI_KEY=

# --- infra ---
DATABASE_PATH=mercury-mesh.db
REDIS_URL=redis://localhost:6379/0
